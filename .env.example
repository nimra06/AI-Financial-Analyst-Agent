# Required for AI executive summaries
OPENAI_API_KEY=sk-your-key-here

# Tier 2 — data retention (days until auto-delete on startup)
DATA_RETENTION_DAYS=90

# Tier 2 — LLM rate limits (requests per minute per user)
CHAT_RATE_LIMIT_PER_MIN=20
SUMMARIZE_RATE_LIMIT_PER_MIN=10

# Tier 4 — database (omit for local SQLite; set for Postgres / Docker)
# DATABASE_URL=postgresql://finanalyst:finanalyst@localhost:5432/finanalyst

# Tier 4 — JWT auth (required in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24

# Tier 4 — Google SSO (optional)
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Tier 4 — observability (optional)
# SENTRY_DSN=
# LOG_LEVEL=INFO

# Tier 4 — worker poll interval (seconds)
WORKER_POLL_SECONDS=2

# Vercel / serverless (set automatically on Vercel; use /tmp SQLite if DATABASE_URL unset)
# VERCEL=1
# For production on Vercel, prefer a hosted Postgres (Neon, Supabase, Vercel Postgres):
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
